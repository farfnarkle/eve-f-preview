<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Dark palette. Every key here must also exist in Colors.Light.xaml; controls use them via DynamicResource so the theme can switch live. -->
	<SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1C1F" />
	<SolidColorBrush x:Key="NavBackgroundBrush" Color="#141517" />
	<SolidColorBrush x:Key="NavItemHoverBrush" Color="#1F2024" />
	<SolidColorBrush x:Key="NavItemSelectedBrush" Color="#25272C" />

	<SolidColorBrush x:Key="CardBackgroundBrush" Color="#232428" />
	<SolidColorBrush x:Key="CardBorderBrush" Color="#2E3035" />
	<SolidColorBrush x:Key="DividerBrush" Color="#2E3035" />

	<SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F2F4" />
	<SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A6AE" />
	<SolidColorBrush x:Key="TextDisabledBrush" Color="#63666D" />

	<SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
	<SolidColorBrush x:Key="AccentHoverBrush" Color="#6AA1FF" />
	<SolidColorBrush x:Key="AccentPressedBrush" Color="#3B78E6" />
	<SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
	<SolidColorBrush x:Key="AccentForegroundBrush" Color="#7FB0FF" />
	<SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E2A40" />

	<SolidColorBrush x:Key="ControlFillBrush" Color="#2B2D32" />
	<SolidColorBrush x:Key="ControlHoverBrush" Color="#33353B" />
	<SolidColorBrush x:Key="ControlPressedBrush" Color="#282A2E" />
	<SolidColorBrush x:Key="ControlBorderBrush" Color="#3A3D44" />
	<SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#4A4E57" />
	<SolidColorBrush x:Key="InputFillBrush" Color="#1E1F23" />

	<SolidColorBrush x:Key="SelectionFillBrush" Color="#2A3550" />
	<SolidColorBrush x:Key="SelectionHoverBrush" Color="#2B2D32" />

	<SolidColorBrush x:Key="PopupBackgroundBrush" Color="#26282C" />
	<SolidColorBrush x:Key="PopupBorderBrush" Color="#393C43" />

	<SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#4A4D55" />
	<SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#62666F" />

	<SolidColorBrush x:Key="DangerBrush" Color="#F2706A" />
	<SolidColorBrush x:Key="DangerHoverBrush" Color="#3A2425" />
	<SolidColorBrush x:Key="SuccessTextBrush" Color="#5BD18B" />
	<SolidColorBrush x:Key="WarningTextBrush" Color="#F2B94B" />

	<!-- Behind the overlay-label preview: looks like a thumbnail in either theme. -->
	<SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#0E0F11" />
	<Color x:Key="ShadowColor">#000000</Color>
</ResourceDictionary>
