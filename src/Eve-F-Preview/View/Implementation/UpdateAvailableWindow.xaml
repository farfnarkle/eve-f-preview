<Window x:Class="EveFPreview.View.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EveFPreview.View"
        Title="EVE-F-Preview update available"
        Icon="pack://application:,,,/EVE-F-Preview;component/original-icon.ico"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        local:ThemeManager.UseThemedTitleBar="True">
	<StackPanel Width="480">
		<DockPanel Margin="24,22,24,0">
			<Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,16,0" VerticalAlignment="Top"
			        Background="{DynamicResource AccentSubtleBrush}">
				<TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
				           Foreground="{DynamicResource AccentForegroundBrush}" />
			</Border>
			<StackPanel>
				<TextBlock Text="Update available" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
				<TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="19" />
				<!-- Collapsed when the release has no notes; filled from the release description in code-behind. -->
				<Border x:Name="ReleaseNotesPanel" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="4"
				        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
					<ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" Margin="12,10" LineHeight="18" FontSize="12" />
					</ScrollViewer>
				</Border>
				<CheckBox x:Name="DontShowAgainCheckBox" Content="Don't show again for this version" Margin="0,16,0,0" />
			</StackPanel>
		</DockPanel>
		<Border Margin="0,22,0,0" Padding="24,16" Background="{DynamicResource NavBackgroundBrush}"
		        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Later" IsCancel="True" Style="{StaticResource ActionButton}" MinWidth="96" Margin="0,0,8,0" Click="LaterButton_Click" />
				<Button x:Name="ViewReleaseButton" Content="View release" IsDefault="True" Style="{StaticResource AccentButton}"
				        MinWidth="120" Click="ViewReleaseButton_Click" />
			</StackPanel>
		</Border>
	</StackPanel>
</Window>
