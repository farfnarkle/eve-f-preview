<UserControl x:Class="EveFPreview.View.CycleAppsSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="CycleAppsSettingsControl_IsVisibleChanged">
	<StackPanel>
		<TextBlock Style="{StaticResource SectionTitle}" Text="Apps" />
		<Border Style="{StaticResource Card}">
			<StackPanel>
				<TextBlock x:Name="NoAppsText" Style="{StaticResource Caption}" Margin="18,16" Text="No apps added yet. Pick a running program below." />
				<ItemsControl x:Name="AppsList" Focusable="False">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border x:Name="Row" Padding="18,10,10,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
								<DockPanel>
									<Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" ToolTip="Remove" Click="RemoveAppButton_Click" Padding="6,4" Margin="8,0,0,0">
										<TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
									</Button>
									<CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludeInDynamicCycle}"
									          ToolTip="Step through this app with the dynamic cycle hotkeys" />
									<TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="Dynamic cycling" VerticalAlignment="Center" Margin="0,0,10,0" />
									<TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Margin="0,0,12,0" Foreground="{DynamicResource TextSecondaryBrush}" />
									<TextBlock Text="{Binding Executable}" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis" />
								</DockPanel>
							</Border>
							<DataTemplate.Triggers>
								<!-- Dividers go between rows only. -->
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
									<Setter TargetName="Row" Property="BorderThickness" Value="0" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>
		<TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap"
		           Text="An added app gets a thumbnail and is cycled like an EVE client, under its program name. Dynamic cycling steps through clients in thumbnail order, so place its thumbnail where it should come in the rotation. To put it in a numbered group instead, add it on the Cycle groups page. Its thumbnail can be hidden on the Clients page." />

		<TextBlock Style="{StaticResource SectionTitle}" Text="Add an app" />
		<Border Style="{StaticResource Card}" Padding="16,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<ComboBox x:Name="RunningProgramsCombo" Margin="0,0,8,0" DisplayMemberPath="DisplayText" />
				<Button Grid.Column="1" Style="{StaticResource SubtleButton}" ToolTip="Refresh the list of running programs" Click="RefreshRunningProgramsButton_Click" Padding="8,6" Margin="0,0,8,0">
					<TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
				</Button>
				<Button x:Name="AddAppButton" Grid.Column="2" Style="{StaticResource AccentButton}" MinWidth="110" Click="AddAppButton_Click">
					<StackPanel Orientation="Horizontal">
						<TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextBrush}" />
						<TextBlock Text="Add" />
					</StackPanel>
				</Button>
			</Grid>
		</Border>
		<TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap"
		           Text="Lists programs that have a window open right now. Start the app first if it isn't listed." />
	</StackPanel>
</UserControl>
