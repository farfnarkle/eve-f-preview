<Window x:Class="EveFPreview.View.SettingsSyncAccountIdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EveFPreview.View"
        xmlns:controls="clr-namespace:EveFPreview.View.Controls"
        Title="Set account ID"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        local:ThemeManager.UseThemedTitleBar="True">
	<StackPanel Width="380">
		<StackPanel Margin="24,20,24,0">
			<TextBlock Text="Account ID" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
			<TextBlock x:Name="PromptText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
			<controls:NumericUpDown x:Name="AccountIdInput" Width="Auto" HorizontalAlignment="Stretch" Margin="0,14,0,0" Minimum="0" Maximum="2147483647" />
		</StackPanel>
		<Border Margin="0,22,0,0" Padding="24,16" Background="{DynamicResource NavBackgroundBrush}"
		        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Cancel" IsCancel="True" Style="{StaticResource ActionButton}" MinWidth="96" Margin="0,0,8,0" />
				<Button Content="Save" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="96" Click="SaveButton_Click" />
			</StackPanel>
		</Border>
	</StackPanel>
</Window>
