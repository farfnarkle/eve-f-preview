<UserControl x:Class="EveFPreview.View.SettingsSyncControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EveFPreview.View"
             xmlns:controls="clr-namespace:EveFPreview.View.Controls">
	<UserControl.Resources>
		<!-- A list that sits flush inside a card rather than drawing its own box. -->
		<Style x:Key="CardList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="8,4,8,8" />
		</Style>
		<Style x:Key="CardHeader" TargetType="StackPanel">
			<Setter Property="Margin" Value="18,14,16,6" />
		</Style>
	</UserControl.Resources>

	<StackPanel>
		<TextBlock Style="{StaticResource SectionTitle}" Text="Copy from" />
		<Border Style="{StaticResource Card}">
			<controls:CardStack>
				<controls:SettingRow Title="EVE settings profile" Description="{x:Static local:SettingsHelpText.SettingsProfile}">
					<ComboBox x:Name="ProfileCombo" Width="260" SelectionChanged="ProfileCombo_SelectionChanged" />
				</controls:SettingRow>
				<controls:SettingRow Title="Source character" Description="{x:Static local:SettingsHelpText.SourceCharacter}">
					<StackPanel Orientation="Horizontal">
						<ComboBox x:Name="SourceCombo" Width="260" SelectionChanged="SourceCombo_SelectionChanged">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}">
										<Run Text="{Binding DisplayName, Mode=OneWay}" /><Run Text="  ·  " Foreground="{DynamicResource TextSecondaryBrush}" /><Run
										     Text="{Binding CharacterId, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
									</TextBlock>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<Button x:Name="SetSourceAccountIdButton" Style="{StaticResource SubtleButton}" Margin="6,0,0,0"
						        ToolTip="Set the source character's account ID" Click="SetSourceAccountIdButton_Click">
							<TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="14" />
						</Button>
					</StackPanel>
				</controls:SettingRow>
			</controls:CardStack>
		</Border>

		<TextBlock Style="{StaticResource SectionTitle}" Text="Copy to" />
		<Border Style="{StaticResource Card}">
			<DockPanel>
				<StackPanel DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
					<TextBlock Text="Destination characters" FontSize="14" />
					<TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
					           Text="Tick the characters to overwrite. Select one to edit which of its chat channels are kept; right-click to set its account ID." />
				</StackPanel>
				<!-- Clicking a row selects it (to edit its channels below); only the checkbox includes it in the sync. -->
				<ListBox x:Name="DestinationList" Style="{StaticResource CardList}" MaxHeight="220" MinHeight="44"
				         ToolTip="{x:Static local:SettingsHelpText.DestinationCharacters}" ToolTipService.InitialShowDelay="1200"
				         SelectionChanged="DestinationList_SelectionChanged">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<DockPanel>
								<CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0" />
								<StackPanel VerticalAlignment="Center">
									<TextBlock Text="{Binding Value.DisplayName}" TextTrimming="CharacterEllipsis" />
									<TextBlock Text="{Binding Value.Details}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
								</StackPanel>
							</DockPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
					<ListBox.ContextMenu>
						<ContextMenu>
							<MenuItem Header="Set account ID…" Click="SetDestinationAccountIdMenuItem_Click" />
						</ContextMenu>
					</ListBox.ContextMenu>
				</ListBox>
			</DockPanel>
		</Border>

		<TextBlock Style="{StaticResource SectionTitle}" Text="Chat channels" />
		<Border Style="{StaticResource Card}">
			<DockPanel>
				<StackPanel DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
					<TextBlock x:Name="ChannelLabel" Text="Channels to keep on copy" FontSize="14" TextWrapping="Wrap" />
					<TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{x:Static local:SettingsHelpText.ChannelsToKeep}" />
				</StackPanel>
				<!-- Clicking anywhere on a channel toggles it. -->
				<ListBox x:Name="ChannelList" Style="{StaticResource CardList}" MaxHeight="240" MinHeight="44">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Text}" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</Border>

		<TextBlock Style="{StaticResource SectionTitle}" Text="Options" />
		<Border Style="{StaticResource Card}">
			<controls:CardStack>
				<controls:SettingRow Title="Keep each alt's own ship module layout" Description="{x:Static local:SettingsHelpText.PreserveModuleLayout}">
					<CheckBox x:Name="PreserveModuleStateCheckBox" Style="{StaticResource ToggleSwitch}" IsChecked="True"
					          Checked="PreserveModuleStateCheckBox_Changed" Unchecked="PreserveModuleStateCheckBox_Changed" />
				</controls:SettingRow>
			</controls:CardStack>
		</Border>

		<DockPanel Margin="0,16,0,0" LastChildFill="False">
			<Button x:Name="SyncButton" DockPanel.Dock="Right" Content="Sync now…" Style="{StaticResource AccentButton}" MinWidth="120" IsEnabled="False" Click="SyncButton_Click" />
			<Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="RefreshButton_Click">
				<StackPanel Orientation="Horizontal">
					<TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0" />
					<TextBlock Text="Refresh" />
				</StackPanel>
			</Button>
		</DockPanel>

		<TextBlock Style="{StaticResource SectionTitle}" Text="Backups" />
		<Border Style="{StaticResource Card}">
			<controls:CardStack>
				<controls:SettingRow Title="Back up EVE settings" Description="Makes a numbered copy of every core_char and core_user file. Manual backups are never overwritten.">
					<Button x:Name="BackupButton" Content="Back up now" Style="{StaticResource ActionButton}" Click="BackupButton_Click" />
				</controls:SettingRow>
				<controls:SettingRow Title="Settings folder" Description="Open the selected profile's folder in File Explorer.">
					<Button x:Name="OpenFolderButton" Content="Open folder" Style="{StaticResource ActionButton}" Click="OpenFolderButton_Click" />
				</controls:SettingRow>
				<controls:SettingRow Title="Delete sync backups" Description="Removes backup files made by sync in this profile. Live settings are not touched.">
					<Button x:Name="DeleteBackupsButton" Content="Delete…" Style="{StaticResource DangerButton}" Click="DeleteBackupsButton_Click" />
				</controls:SettingRow>
			</controls:CardStack>
		</Border>

		<!-- Still kept up to date, but not shown: they were trimmed from the tab (commit 306a69d). -->
		<TextBlock x:Name="AutoSyncProfileLabel" Visibility="Collapsed" />
		<TextBlock x:Name="StatusLabel" Visibility="Collapsed" />
	</StackPanel>
</UserControl>
