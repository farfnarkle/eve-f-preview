<Application x:Class="EveFPreview.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!-- The colour palette comes first; ThemeManager swaps it for Colors.Light.xaml at runtime. -->
				<ResourceDictionary Source="View/Themes/Colors.Dark.xaml" />
				<ResourceDictionary Source="View/Themes/Controls.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>
